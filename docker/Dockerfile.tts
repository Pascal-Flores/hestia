FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
ARG TARGETARCH
# Avoid downloading CUDA-enabled PyTorch wheels on x86; ARM64 uses PyPI's ARM wheels.
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch>=2.5'; \
    fi
RUN pip install --no-cache-dir 'pocket-tts>=0.1'
RUN useradd --create-home --uid 10003 tts \
    && mkdir -p /cache/hf && chown -R tts:tts /cache
USER tts
ENV HF_HOME=/cache/hf
EXPOSE 8000
CMD ["pocket-tts", "serve", "--host", "0.0.0.0", "--port", "8000", "--language", "french"]
