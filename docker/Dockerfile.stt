FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir 'fastapi>=0.115,<1' 'uvicorn>=0.30,<1' \
    'python-multipart>=0.0.18' 'faster-whisper>=1.1,<2'
COPY services/stt/app.py ./app.py
RUN useradd --create-home --uid 10002 stt \
    && mkdir -p /cache/hf && chown -R stt:stt /cache
USER stt
EXPOSE 8001
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
