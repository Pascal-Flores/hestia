# Copy to native.env (trusted shell configuration; do not source untrusted content).
# Hestia is bound to loopback by default. If exposed to LAN, set a strong API key.
HESTIA_MEMORY_PROFILE=auto
HESTIA_BIND_IP=127.0.0.1
HESTIA_PORT=8765
# HESTIA_API_KEY=replace-with-a-long-random-secret
HESTIA_VOICE_PROFILE=natural
