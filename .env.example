# Hestia Rust: a single compose.yaml file runs core, LLM, Whisper, Pocket TTS and listener.
# Set a strong HESTIA_API_KEY and firewall rules before exposing to a LAN.
HESTIA_BIND_IP=127.0.0.1
HESTIA_PORT=8765
HESTIA_API_KEY=
RUST_LOG=info

# Rust semantic routing (FastEmbed multilingual-e5-small is bundled in this version).
HESTIA_ROUTE_MIN_SCORE=0.80
HESTIA_ROUTE_MIN_MARGIN=0.035
HESTIA_VOICE_PROFILE=natural
# Digits -> French words only in speech, not HTTP/JSON values.
HESTIA_TTS_NORMALIZE_NUMBERS=1

# Local text LLM used for parameter extraction and short responses.
LLM_THREADS=2
LLM_MAX_TOKENS=256
# LLM_CONTEXT=2048
# LLM_HF_REPO=bartowski/Qwen_Qwen3-0.6B-GGUF:Q4_K_M

# Optional conversation fallback; default is the local LLM.
# HESTIA_FALLBACK_LLM_URL=https://provider.example/v1/chat/completions
# HESTIA_FALLBACK_LLM_MODEL=my-model
# HESTIA_FALLBACK_LLM_API_KEY=

# Whisper multilingual French (base is the default; small improves accuracy at higher RAM).
# Leave commented to let ./scripts/up.sh choose based on memory profile.
# STT_MODEL=base
STT_LANGUAGE=fr
STT_CPU_THREADS=2

# Compact Rust Pocket TTS.
TTS_LANGUAGE=french
TTS_VOICE=estelle
TTS_QUANTIZE=1
TTS_THREADS=2

# Internal device selection service: reached by Rust over Docker's private network.
# No host port is published. UI selections are persisted in recordings/device-settings.json.
LISTENER_CONTROL_PORT=8766
# The listener starts with regular docker compose up on a Linux host with /dev/snd.
# Headless: docker compose up -d --scale listener=0
# Built-in demo wake word is "hey jarvis", not "Hestia".
# LISTENER_WAKE_MODEL=/models/wakeword/hestia.onnx
LISTENER_WAKE_MODEL=hey jarvis
LISTENER_WAKE_THRESHOLD=0.55
LISTENER_WAKE_CONSECUTIVE=1
LISTENER_FILTER=rnnoise
LISTENER_QUEUE_BLOCKS=16
LISTENER_PORTAUDIO_BLOCKSIZE=0
LISTENER_INPUT_LATENCY=
LISTENER_METRICS_INTERVAL=30
LISTENER_DEBUG_WAKE=0
LISTENER_DIAGNOSTICS_INTERVAL=5
LISTENER_INPUT_DEVICE=
LISTENER_OUTPUT_DEVICE=
LISTENER_OUTPUT_RATE=0
LISTENER_DEBUG_AUDIO=0
LISTENER_AUDIO_GID=29
LISTENER_UID=1000
LISTENER_GID=1000
LISTENER_SILENCE=0.85
LISTENER_INITIAL_TIMEOUT=3.5
LISTENER_MAX_UTTERANCE=12.0
LISTENER_MIN_VOICE=0.20
LISTENER_RMS_THRESHOLD=0.008
LISTENER_SPEECH_THRESHOLD=0.30
LISTENER_LOG_LEVEL=INFO
