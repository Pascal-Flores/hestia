# Copy to .env before docker compose up. No secrets are required for local use.
# Bind to localhost by default. For LAN/ESP32 access use HESTIA_BIND_IP=0.0.0.0
# and SET A STRONG HESTIA_API_KEY, plus a firewall or trusted-network rules.
HESTIA_BIND_IP=127.0.0.1
HESTIA_PORT=8765
HESTIA_API_KEY=
HESTIA_ALLOWED_PERMISSIONS=
HESTIA_ROUTE_MIN_SCORE=0.80
HESTIA_ROUTE_MIN_MARGIN=0.035
HESTIA_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HESTIA_VOICE_PROFILE=natural

# Local inference model (first boot downloads GGUF). Defaults are compact.
# When using ./scripts/up.sh, let the RAM profile select the model/context automatically.
# LLM_HF_REPO=bartowski/Qwen_Qwen3-0.6B-GGUF:Q4_K_M
# LLM_CONTEXT=2048
LLM_THREADS=2
HESTIA_LLM_TIMEOUT=180
LLM_MAX_TOKENS=256

# STT local Whisper; 'base' trades RAM/CPU for improved recognition.
# STT_MODEL=tiny
STT_LANGUAGE=fr
STT_CPU_THREADS=2

# Pocket TTS voice (use French base model rather than large 24-layer preview).
TTS_LANGUAGE=french
TTS_VOICE=estelle
TTS_DOCKERFILE=docker/Dockerfile.tts-rust
TTS_QUANTIZE=1
TTS_THREADS=2

# No-match conversation fallback: defaults to local LLM.
# You may set a remote OpenAI-compatible endpoint + its credentials.
# HESTIA_FALLBACK_LLM_URL=https://example.org/v1/chat/completions
# HESTIA_FALLBACK_LLM_MODEL=some-larger-model
# HESTIA_FALLBACK_LLM_API_KEY=secret

# The native Rust TTS container eliminates Python/PyTorch. To revert temporarily:
# TTS_DOCKERFILE=docker/Dockerfile.tts
# and TTS_QUANTIZE=0 (the Python image may not support the native entrypoint).
# HESTIA_MEMORY_PROFILE=auto  # 2g, 4g or 8g; used by ./scripts/up.sh

# Optional always-on microphone / speaker listener on the Docker host (Linux ALSA).
# Start it with: docker compose --profile listener up -d --build
# Default test wake word: "hey jarvis". To use "Hestia", supply your OWN trained .onnx:
# LISTENER_WAKE_MODEL=/models/wakeword/hestia.onnx
LISTENER_WAKE_MODEL=hey jarvis
LISTENER_WAKE_THRESHOLD=0.55
LISTENER_WAKE_CONSECUTIVE=1
# RNNoise enhances speech; it does not guarantee removal of all music.
# Compare with LISTENER_FILTER=none and --record-sample.
LISTENER_FILTER=rnnoise
LISTENER_INPUT_DEVICE=
LISTENER_OUTPUT_DEVICE=
# Group that owns /dev/snd on the host; usually 29 (audio) on Ubuntu.
LISTENER_AUDIO_GID=29
LISTENER_SILENCE=0.85
LISTENER_INITIAL_TIMEOUT=3.5
LISTENER_MAX_UTTERANCE=12.0
LISTENER_MIN_VOICE=0.20
LISTENER_RMS_THRESHOLD=0.008
LISTENER_SPEECH_THRESHOLD=0.30
LISTENER_LOG_LEVEL=INFO
